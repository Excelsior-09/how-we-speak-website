# ==============================================================================
# HOW WE SPEAK — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and populate with your credentials.
# NEVER commit .env to version control.
# ==============================================================================

# ── SUPABASE (Database, Auth & Row Level Security) ───────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_or_publishable_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Server-side only (keep strictly confidential, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── FRONTEND (Vite environment variables) ────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_or_publishable_key
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# ── AI ENGINE (Google Gemini via Supabase Edge Function or Server) ───────────
# Configured in Supabase Edge Function Secrets as GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
AI_MODEL=gemini-flash-latest

# ── GUMROAD INTEGRATION ──────────────────────────────────────────────────────
# Webhook verification secret for purchase provisioning
GUMROAD_WEBHOOK_SECRET=your_gumroad_webhook_secret_here

# ── APPLICATION URLs ─────────────────────────────────────────────────────────
APP_URL=https://tryhowwespeak.com
LOCAL_DEV_URL=http://localhost:3000
