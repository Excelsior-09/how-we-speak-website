# ==============================================================================
# HOW WE SPEAK — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and populate with your live credentials.
# NEVER commit .env to version control.
# ==============================================================================

# ── SUPABASE (Database, Auth & Row Level Security) ───────────────────────────
# Found in Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-side only (Service Role Key with bypass RLS - keep strictly confidential)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── AI BACKEND (Relationship Translator & De-escalation Engine) ──────────────
# Supported: Google Gemini, OpenAI, or Anthropic
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-1.5-pro

# ── GUMROAD INTEGRATION ──────────────────────────────────────────────────────
# Webhook verification secret for purchase provisioning
GUMROAD_WEBHOOK_SECRET=your_gumroad_webhook_secret_here

# ── APPLICATION CONFIGURATION ────────────────────────────────────────────────
APP_URL=https://tryhowwespeak.com
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
