# ==============================================================================
# HOW WE SPEAK — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and populate with your credentials.
# NEVER commit .env to version control.
# ==============================================================================

# ── SUPABASE (Database, Auth & Row Level Security) ───────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_or_publishable_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Server-side only (keep strictly confidential, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── FRONTEND (Vite environment variables) ────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_or_publishable_key
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# ── AI ENGINE (Google Gemini via Supabase Edge Function or Server) ───────────
# Configured in Supabase Edge Function Secrets as GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
AI_MODEL=gemini-flash-latest

# ── GUMROAD INTEGRATION ──────────────────────────────────────────────────────
# Webhook verification secret for purchase provisioning
GUMROAD_WEBHOOK_SECRET=your_gumroad_webhook_secret_here

# ── GOOGLE reCAPTCHA & BOT DEFENSE ───────────────────────────────────────────
# Public client site key (Safe for frontend HTML / JS bundles)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
# Private server secret key (Strictly server-side only: Vercel / Supabase Secrets)
# NEVER commit or expose to client bundles or browser storage
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# ── APPLICATION URLs ─────────────────────────────────────────────────────────
APP_URL=https://tryhowwespeak.com
LOCAL_DEV_URL=http://localhost:3000

# ── PADDLE BILLING INTEGRATION (LIVE / PRODUCTION) ───────────────────────────
# Environment: production (default) or sandbox
PADDLE_ENVIRONMENT=production

# Public client-side token for Paddle.js Checkout (prefix live_ for production, test_ for sandbox)
# Safe for frontend HTML/JS bundles. Dashboard: Developer tools > Authentication > Client-side tokens
VITE_PADDLE_CLIENT_TOKEN=live_your_live_client_side_token_here

# Server-side API key for server operations (keep strictly confidential)
# Dashboard: Developer tools > Authentication > API keys
PADDLE_API_KEY=your_paddle_live_api_key_here

# Webhook notification destination signing secret (prefix pdl_ntf_set_)
# Dashboard: Developer tools > Notifications > [Your destination] > Signing secret
# NEVER delete/recreate an existing destination as it rotates this secret!
PADDLE_WEBHOOK_SECRET_KEY=pdl_ntf_set_your_live_signing_secret_here

# Live Product Price IDs (pri_...) created in Paddle Live catalog
PADDLE_PRICE_BUNDLE=pri_your_live_complete_bundle_price_id
PADDLE_PRICE_MEN_EDITION=pri_your_live_men_edition_price_id
PADDLE_PRICE_WOMEN_EDITION=pri_your_live_women_edition_price_id
PADDLE_PRICE_SCRIPTS=pri_your_live_scripts_price_id
PADDLE_PRICE_SEX_TALK=pri_your_live_sex_talk_price_id


