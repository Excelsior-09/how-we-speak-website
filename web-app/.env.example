# ==============================================================================
# HOW WE SPEAK (WEB APP) — ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env and populate with your Supabase project credentials.
# Only publishable/anon keys should be placed here.
# NEVER include service_role keys or secrets in frontend client code.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
